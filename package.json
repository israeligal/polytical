{
  "name": "polytical",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:caricatures": "tsx --env-file=.env scripts/check-caricatures.ts",
    "ingest:knesset": "tsx --env-file=.env scripts/ingest-knesset.ts",
    "ingest:knesset:full": "tsx --env-file=.env scripts/ingest-knesset.ts --full",
    "ingest:votes": "tsx --env-file=.env scripts/ingest-votes.ts",
    "ingest:votes:backfill": "tsx --env-file=.env scripts/ingest-votes.ts --backfill",
    "user:create": "tsx --env-file=.env scripts/create-user.ts",
    "seed:markets": "tsx --env-file=.env scripts/seed-markets.ts",
    "seed:season": "tsx --env-file=.env scripts/seed-season.ts",
    "backfill:market-search": "tsx --env-file=.env scripts/backfill-market-search.ts",
    "backfill:politician-search": "tsx --env-file=.env scripts/backfill-politician-search.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.5.6",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@storybook/addon-a11y": "10.4.1",
    "@storybook/nextjs-vite": "10.4.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "happy-dom": "^20.9.0",
    "storybook": "10.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite": "^7.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
